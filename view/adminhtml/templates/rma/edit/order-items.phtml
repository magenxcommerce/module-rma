use Magenx\Rma\Block\Adminhtml\Rma\Edit\OrderItems;

/**
 * @var OrderItems $block
 */

$isEdit = $block->isEditMode();
$rmaItems = $isEdit ? $block->getRmaItems() : null;
?>

<?php if ($isEdit && $rmaItems): ?>
<section class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('Requested Items')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <table class="admin__table-secondary rma-items-table">
            <thead>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Product Name')) ?></th>
                    <th><?= $escaper->escapeHtml(__('SKU')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Qty Requested')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Qty Approved')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Qty Received')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Condition')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($rmaItems as $item): ?>
                    <?php $orderItemInfo = $block->getOrderItemInfo((int)$item->getOrderItemId()); ?>
                    <tr>
                        <td><?= $escaper->escapeHtml($orderItemInfo['name']) ?></td>
                        <td><?= $escaper->escapeHtml($orderItemInfo['sku']) ?></td>
                        <td><?= (int)$item->getQtyRequested() ?></td>
                        <?php foreach (['qty_approved' => $item->getQtyApproved(), 'qty_returned' => $item->getQtyReturned()] as $field => $qty): ?>
                            <td>
                                <input type="number" class="admin__control-text rma-item-qty-input" min="0"
                                       max="<?= (int)$item->getQtyRequested() ?>"
                                       data-item-id="<?= (int)$item->getEntityId() ?>"
                                       data-field="<?= $escaper->escapeHtmlAttr($field) ?>"
                                       value="<?= $qty === null ? '' : (int)$qty ?>"/>
                            </td>
                        <?php endforeach; ?>
                        <td><?= $escaper->escapeHtml($block->getConditionLabel($item->getConditionId())) ?></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</section>
<script type="text/x-magento-init">
    {
        ".rma-items-table": {
            "Magenx_Rma/js/rma-item-qtys": {
                "provider": "rma_form.rma_form_data_source"
            }
        }
    }
</script>
<?php elseif (!$isEdit): ?>
<section class="admin__page-section" id="rma-order-items-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('Order Items')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <div id="rma-order-items-container">
            <p class="rma-items-message"><?= $escaper->escapeHtml(__('Select an order to see available items.')) ?></p>
        </div>
    </div>
</section>
<?php endif; ?>

