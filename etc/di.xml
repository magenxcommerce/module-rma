-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Data Interfaces -->
    <preference for="Magenx\Rma\Api\Data\RMAInterface" type="Magenx\Rma\Model\RMA"/>
    <preference for="Magenx\Rma\Api\Data\StatusInterface" type="Magenx\Rma\Model\Status"/>
    <preference for="Magenx\Rma\Api\Data\ReasonInterface" type="Magenx\Rma\Model\Reason"/>
    <preference for="Magenx\Rma\Api\Data\ResolutionTypeInterface" type="Magenx\Rma\Model\ResolutionType"/>
    <preference for="Magenx\Rma\Api\Data\ItemConditionInterface" type="Magenx\Rma\Model\ItemCondition"/>
    <preference for="Magenx\Rma\Api\Data\ItemInterface" type="Magenx\Rma\Model\Item"/>
    <preference for="Magenx\Rma\Api\Data\CommentInterface" type="Magenx\Rma\Model\Comment"/>
    <preference for="Magenx\Rma\Api\Data\AttachmentInterface" type="Magenx\Rma\Model\Attachment"/>

    <!-- SearchResults Interfaces -->
    <preference for="Magenx\Rma\Api\Data\RMASearchResultsInterface" type="Magenx\Rma\Model\Data\RMASearchResults"/>
    <preference for="Magenx\Rma\Api\Data\CommentSearchResultsInterface" type="Magenx\Rma\Model\Data\CommentSearchResults"/>
    <preference for="Magenx\Rma\Api\Data\StatusSearchResultsInterface" type="Magenx\Rma\Model\Data\StatusSearchResults"/>
    <preference for="Magenx\Rma\Api\Data\ReasonSearchResultsInterface" type="Magenx\Rma\Model\Data\ReasonSearchResults"/>
    <preference for="Magenx\Rma\Api\Data\ResolutionTypeSearchResultsInterface" type="Magenx\Rma\Model\Data\ResolutionTypeSearchResults"/>
    <preference for="Magenx\Rma\Api\Data\ItemConditionSearchResultsInterface" type="Magenx\Rma\Model\Data\ItemConditionSearchResults"/>
    <preference for="Magenx\Rma\Api\Data\ItemSearchResultsInterface" type="Magenx\Rma\Model\Data\ItemSearchResults"/>
    <preference for="Magenx\Rma\Api\Data\AttachmentSearchResultsInterface" type="Magenx\Rma\Model\Data\AttachmentSearchResults"/>

    <!-- Email -->
    <preference for="Magenx\Rma\Api\Email\SenderInterface" type="Magenx\Rma\Service\Email\Sender"/>

    <!-- Grid Collections -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="rma_listing_data_source" xsi:type="string">Magenx\Rma\Model\ResourceModel\RMA\Grid\Collection</item>
                <item name="rma_status_listing_data_source" xsi:type="string">Magenx\Rma\Model\ResourceModel\Status\Grid\Collection</item>
                <item name="rma_reason_listing_data_source" xsi:type="string">Magenx\Rma\Model\ResourceModel\Reason\Grid\Collection</item>
                <item name="rma_resolution_type_listing_data_source" xsi:type="string">Magenx\Rma\Model\ResourceModel\ResolutionType\Grid\Collection</item>
                <item name="rma_item_condition_listing_data_source" xsi:type="string">Magenx\Rma\Model\ResourceModel\ItemCondition\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!-- Store Labels Modifier Pool -->
    <virtualType name="Magenx\Rma\Ui\DataProvider\Form\Modifier\Pool" type="Magento\Ui\DataProvider\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="store_labels" xsi:type="array">
                    <item name="class" xsi:type="string">Magenx\Rma\Ui\DataProvider\Form\Modifier\StoreLabels</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Form DataProviders with Modifier Pool -->
    <type name="Magenx\Rma\Model\Status\DataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">Magenx\Rma\Ui\DataProvider\Form\Modifier\Pool</argument>
        </arguments>
    </type>
    <type name="Magenx\Rma\Model\Reason\DataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">Magenx\Rma\Ui\DataProvider\Form\Modifier\Pool</argument>
        </arguments>
    </type>
    <type name="Magenx\Rma\Model\ResolutionType\DataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">Magenx\Rma\Ui\DataProvider\Form\Modifier\Pool</argument>
        </arguments>
    </type>
    <type name="Magenx\Rma\Model\ItemCondition\DataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">Magenx\Rma\Ui\DataProvider\Form\Modifier\Pool</argument>
        </arguments>
    </type>

    <!-- CLI Commands -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="rma_cleanup" xsi:type="object">Magenx\Rma\Console\Command\CleanupCommand</item>
                <item name="rma_list" xsi:type="object">Magenx\Rma\Console\Command\ListCommand</item>
                <item name="rma_status" xsi:type="object">Magenx\Rma\Console\Command\StatusCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Repository Interfaces -->
    <preference for="Magenx\Rma\Api\RMARepositoryInterface" type="Magenx\Rma\Model\RMARepository"/>
    <preference for="Magenx\Rma\Api\StatusRepositoryInterface" type="Magenx\Rma\Model\StatusRepository"/>
    <preference for="Magenx\Rma\Api\ReasonRepositoryInterface" type="Magenx\Rma\Model\ReasonRepository"/>
    <preference for="Magenx\Rma\Api\ResolutionTypeRepositoryInterface" type="Magenx\Rma\Model\ResolutionTypeRepository"/>
    <preference for="Magenx\Rma\Api\ItemConditionRepositoryInterface" type="Magenx\Rma\Model\ItemConditionRepository"/>
    <preference for="Magenx\Rma\Api\ItemRepositoryInterface" type="Magenx\Rma\Model\ItemRepository"/>
    <preference for="Magenx\Rma\Api\CommentRepositoryInterface" type="Magenx\Rma\Model\CommentRepository"/>
    <preference for="Magenx\Rma\Api\AttachmentRepositoryInterface" type="Magenx\Rma\Model\AttachmentRepository"/>

    <!-- Management Interfaces -->
    <preference for="Magenx\Rma\Api\RmaCommentManagementInterface" type="Magenx\Rma\Model\RmaCommentManagement"/>
    <preference for="Magenx\Rma\Api\RmaItemManagementInterface" type="Magenx\Rma\Model\RmaItemManagement"/>

    <!-- Listing Actions Virtual Types -->
    <virtualType name="Magenx\Rma\Ui\Component\Listing\Column\ReasonActions" type="Magenx\Rma\Ui\Component\Listing\Column\GenericEntityActions">
        <arguments>
            <argument name="editUrlPath" xsi:type="string">rma/reason/edit</argument>
            <argument name="deleteUrlPath" xsi:type="string">rma/reason/delete</argument>
            <argument name="entityLabel" xsi:type="string">reason</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magenx\Rma\Ui\Component\Listing\Column\ResolutionTypeActions" type="Magenx\Rma\Ui\Component\Listing\Column\GenericEntityActions">
        <arguments>
            <argument name="editUrlPath" xsi:type="string">rma/resolutionType/edit</argument>
            <argument name="deleteUrlPath" xsi:type="string">rma/resolutionType/delete</argument>
            <argument name="entityLabel" xsi:type="string">resolution type</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magenx\Rma\Ui\Component\Listing\Column\ItemConditionActions" type="Magenx\Rma\Ui\Component\Listing\Column\GenericEntityActions">
        <arguments>
            <argument name="editUrlPath" xsi:type="string">rma/itemCondition/edit</argument>
            <argument name="deleteUrlPath" xsi:type="string">rma/itemCondition/delete</argument>
            <argument name="entityLabel" xsi:type="string">item condition</argument>
        </arguments>
    </virtualType>

    <!-- Form Button Virtual Types: Back -->
    <virtualType name="Magenx\Rma\Block\Adminhtml\Rma\Edit\BackButton" type="Magenx\Rma\Block\Adminhtml\GenericBackButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\Status\Edit\BackButton" type="Magenx\Rma\Block\Adminhtml\GenericBackButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\Reason\Edit\BackButton" type="Magenx\Rma\Block\Adminhtml\GenericBackButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\ResolutionType\Edit\BackButton" type="Magenx\Rma\Block\Adminhtml\GenericBackButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\ItemCondition\Edit\BackButton" type="Magenx\Rma\Block\Adminhtml\GenericBackButton"/>

    <!-- Form Button Virtual Types: Save -->
    <virtualType name="Magenx\Rma\Block\Adminhtml\Rma\Edit\SaveButton" type="Magenx\Rma\Block\Adminhtml\GenericSaveButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\Status\Edit\SaveButton" type="Magenx\Rma\Block\Adminhtml\GenericSaveButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\Reason\Edit\SaveButton" type="Magenx\Rma\Block\Adminhtml\GenericSaveButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\ResolutionType\Edit\SaveButton" type="Magenx\Rma\Block\Adminhtml\GenericSaveButton"/>
    <virtualType name="Magenx\Rma\Block\Adminhtml\ItemCondition\Edit\SaveButton" type="Magenx\Rma\Block\Adminhtml\GenericSaveButton"/>

    <!-- Form Button Virtual Types: Delete (with custom confirm messages) -->
    <virtualType name="Magenx\Rma\Block\Adminhtml\Rma\Edit\DeleteButton" type="Magenx\Rma\Block\Adminhtml\GenericDeleteButton">
        <arguments>
            <argument name="confirmMessage" xsi:type="string">Are you sure you want to delete this RMA request?</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magenx\Rma\Block\Adminhtml\Reason\Edit\DeleteButton" type="Magenx\Rma\Block\Adminhtml\GenericDeleteButton">
        <arguments>
            <argument name="confirmMessage" xsi:type="string">Are you sure you want to delete this reason?</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magenx\Rma\Block\Adminhtml\ResolutionType\Edit\DeleteButton" type="Magenx\Rma\Block\Adminhtml\GenericDeleteButton">
        <arguments>
            <argument name="confirmMessage" xsi:type="string">Are you sure you want to delete this resolution type?</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magenx\Rma\Block\Adminhtml\ItemCondition\Edit\DeleteButton" type="Magenx\Rma\Block\Adminhtml\GenericDeleteButton">
        <arguments>
            <argument name="confirmMessage" xsi:type="string">Are you sure you want to delete this item condition?</argument>
        </arguments>
    </virtualType>

    <!-- Withdrawal declarations are recorded by the helpdesk module, which
         overrides this preference; until then the withdrawal mutation is off. -->
    <preference for="Magenx\Rma\Api\WithdrawalDeclarationRecorderInterface"
                type="Magenx\Rma\Model\Withdrawal\UnavailableDeclarationRecorder"/>
</config>
