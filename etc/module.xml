    Magenx_Rma — RMA backend engine.

    Magento_GraphQl is deliberately NOT sequenced here: the GraphQL surface
    lives in the sibling Magenx_RmaGraphQl module (the Catalog / CatalogGraphQl
    split), so this module can be deployed on a store that never exposes
    returns over GraphQL.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magenx_Rma">
        <sequence>
            <module name="Magento_Sales"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Store"/>
            <module name="Magento_Config"/>
            <module name="Magento_Ui"/>
            <module name="Magento_Webapi"/>
            <!-- Service\Email\Sender pulls product thumbnails through Magento_Catalog,
                 and Service\AttachmentService uploads through Magento_MediaStorage. -->
            <module name="Magento_Catalog"/>
            <module name="Magento_MediaStorage"/>
        </sequence>
    </module>
</config>
